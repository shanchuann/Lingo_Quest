# DeepSeek AI
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lingo_quest
MYSQL_USERNAME=root
MYSQL_PASSWORD=lingoquest123

# Redis (optional — set REDIS_ENABLED=false to run MySQL-only;
# cache / rate limit / weekly leaderboard then use in-process fallbacks)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# Server
SERVER_PORT=8080
